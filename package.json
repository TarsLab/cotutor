{
  "name": "cotutor",
  "version": "0.2.0",
  "description": "家里的 AI 老师团,和家长一起教:老师 = 可直接对话的 agent 文件 + 自己的会话;一孩一 workspace",
  "type": "module",
  "license": "MIT",
  "repository": "github:TarsLab/cotutor",
  "homepage": "https://github.com/TarsLab/cotutor#readme",
  "bugs": "https://github.com/TarsLab/cotutor/issues",
  "keywords": [
    "ai",
    "agent",
    "claude-code",
    "qwen-code",
    "tutor",
    "education",
    "homeschool",
    "cli"
  ],
  "bin": {
    "cotutor": "bin/cotutor.js"
  },
  "exports": {
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./workspace": {
      "types": "./dist/cli/workspace.d.ts",
      "default": "./dist/cli/workspace.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "agents",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types scripts/test.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run build:stage && pnpm run smoke",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "build:stage": "node scripts/build-stage.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "drawtell": "^0.6.1",
    "drawtell-skills": "^0.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0"
  }
}
