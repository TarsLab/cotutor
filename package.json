{
  "name": "cotutor",
  "version": "0.4.4",
  "releaseNotes": [
    "装得快多了:安装从 275 个包变成 15 个,Windows 上第一次装从 3 分钟左右变成 1 分钟左右",
    "平板第一次用:在家长端「扫码打开」点「装证书」,用平板相机扫一下就能装根证书",
    "电脑关了或睡着时,孩子在平板上打开看到「老师们还没到」,不再是浏览器的报错;电脑好了自己回来",
    "有了一行安装命令(Mac、Windows 都有),README 里也写了怎么卸载"
  ],
  "description": "AI tutors that co-teach with parents at home: real-time voice, an interactive whiteboard, and learning memory in your own Obsidian vault. Self-hosted; built for China's elementary curriculum.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TarsLab/cotutor.git"
  },
  "homepage": "https://github.com/TarsLab/cotutor#readme",
  "bugs": "https://github.com/TarsLab/cotutor/issues",
  "keywords": [
    "ai",
    "agent",
    "qwen-code",
    "tutor",
    "education",
    "elementary",
    "realtime",
    "voice",
    "obsidian",
    "cli"
  ],
  "bin": {
    "cotutor": "bin/cotutor.js"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./workspace": {
      "types": "./dist/app/workspace.d.ts",
      "default": "./dist/app/workspace.js"
    },
    "./lib": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "grades",
    "themes",
    "avatars",
    "cards",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE",
    "install.sh",
    "install.ps1",
    "CHANGELOG.md"
  ],
  "scripts": {
    "gen:skills": "node --experimental-strip-types scripts/gen-skills.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types scripts/test.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run build:stage && pnpm run smoke",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "build:stage": "node scripts/build-stage.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "2.0.78",
    "ai": "7.0.155",
    "hanzi-writer-data": "2.0.1",
    "typescript": "^5.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
